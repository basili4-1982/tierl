# Скопируйте в .env и при необходимости измените: cp .env.example .env
# .env содержит секреты, уже исключён из git. Никогда не коммитьте его.
#
# Docker Compose читает этот файл автоматически. Переменные POSTGRES_* и
# TIERL_PORT используются только compose; остальные TIERL_* читает приложение.
# Для запуска приложения на хосте (make run) экспортируйте переменные вручную
# или используйте make migrate-up с DATABASE_URL.

# --- Docker Compose: порты и PostgreSQL -------------------------------------
# Порт UI/API на хосте. Compose публикует его только на 127.0.0.1.
TIERL_PORT=8080
# Порт PostgreSQL на хосте (для make migrate-up и psql), тоже только на 127.0.0.1.
POSTGRES_PORT=5432
# Учётные данные контейнера PostgreSQL. Внутри compose из них же собирается
# TIERL_DATABASE_URL, поэтому меняйте пароль здесь.
POSTGRES_USER=tierl
POSTGRES_PASSWORD=tierl
POSTGRES_DB=tierl

# --- Приложение -------------------------------------------------------------
# Адрес HTTP-сервера. В контейнере всегда :8080, снаружи порт задаёт TIERL_PORT.
TIERL_HTTP_ADDR=:8080
# URL PostgreSQL для запуска приложения вне Docker (make run, go run).
# Compose формирует свой URL из POSTGRES_* и эту строку не использует.
# Если меняете POSTGRES_PASSWORD/PORT/DB, обновите её для запуска на хосте.
TIERL_DATABASE_URL=postgres://tierl:tierl@localhost:5432/tierl?sslmode=disable
# Уровень логов: debug, info, warn, error. Логи пишутся в stdout в JSON.
TIERL_LOG_LEVEL=info
# Сколько ждать завершения текущих запросов при SIGTERM/SIGINT.
TIERL_SHUTDOWN_TIMEOUT=10s
# Применять неприменённые миграции при старте. Удобно для compose и одиночного
# инстанса. В production с несколькими репликами лучше false и отдельный шаг.
TIERL_MIGRATE_ON_START=true
# Соль для хэширования IP в rate limiting. Обязательна, если задан
# TIERL_DATABASE_URL. Для production: openssl rand -hex 32 и храните как секрет.
TIERL_IP_HASH_SALT=dev-only-ip-hash-salt-change-me

# --- Пароли: argon2id (ADR-003) ---------------------------------------------
# Стоимость хэширования; подбирайте под железо деплоя (память в KiB).
TIERL_ARGON2_MEMORY_KIB=65536
TIERL_ARGON2_ITERATIONS=3
TIERL_ARGON2_PARALLELISM=2

# --- Rate limiting: создание тир-листов на IP -------------------------------
# Сколько запросов можно сделать подряд и за сколько пополняется один токен.
TIERL_RATELIMIT_CREATE_TIERLIST_BURST=10
TIERL_RATELIMIT_CREATE_TIERLIST_INTERVAL=30s

# --- Хранилище картинок (internal/media) ------------------------------------
# fs — локальная файловая система, s3 — S3-совместимое хранилище.
# В текущей сборке загрузка картинок через HTTP ещё не подключена; переменные
# читаются конфигом и понадобятся при включении медиа.
TIERL_STORAGE_TYPE=fs
# Каталог для fs; для контейнера задайте путь на смонтированном volume.
TIERL_STORAGE_FS_PATH=./data/media
# Базовый URL, по которому отдаются картинки.
TIERL_STORAGE_PUBLIC_URL=/media
# Параметры S3 используются только при TIERL_STORAGE_TYPE=s3.
# TIERL_S3_ENDPOINT — host:port без схемы (для MinIO из compose: localhost:9000
# с хоста или minio:9000 из другого контейнера). ENDPOINT, BUCKET, ACCESS_KEY
# и SECRET_KEY обязательны при TIERL_STORAGE_TYPE=s3.
TIERL_S3_ENDPOINT=
TIERL_S3_BUCKET=
TIERL_S3_ACCESS_KEY=
TIERL_S3_SECRET_KEY=
# Регион, например us-east-1; для MinIO можно оставить пустым.
TIERL_S3_REGION=
# Использовать HTTPS при обращении к S3.
TIERL_S3_USE_SSL=false

# --- Необязательные сервисы (docker compose --profile tools) ----------------
# Логин/пароль MinIO. Значения ниже — только для локальной разработки.
# MINIO_ROOT_USER=tierl
# MINIO_ROOT_PASSWORD=tierl-secret
