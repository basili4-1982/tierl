# Copy to .env and adjust. Never commit .env.
TIERL_HTTP_ADDR=:8080
TIERL_DATABASE_URL=postgres://tierl:tierl@localhost:5432/tierl?sslmode=disable
TIERL_LOG_LEVEL=info
TIERL_SHUTDOWN_TIMEOUT=10s
# argon2id password hashing cost (defaults: 64 MiB, 3 passes, 2 lanes); tune to the deployment hardware.
TIERL_ARGON2_MEMORY_KIB=65536
TIERL_ARGON2_ITERATIONS=3
TIERL_ARGON2_PARALLELISM=2
TIERL_MIGRATE_ON_START=false
# Salt for the IP hash used by rate limiting. Required when TIERL_DATABASE_URL is set.
# Dev value only: generate a long random string for production (openssl rand -hex 32).
TIERL_IP_HASH_SALT=dev-only-ip-hash-salt-change-me
# Tier list creation limit per IP: burst size and refill time of one token.
TIERL_RATELIMIT_CREATE_TIERLIST_BURST=10
TIERL_RATELIMIT_CREATE_TIERLIST_INTERVAL=30s

# Similarity metric (ADR-001): "thinks like you" threshold, answers needed for
# a percentage, and the minimal common items for a comparable pair.
TIERL_SIMILARITY_THRESHOLD=0.8
TIERL_SIMILARITY_MIN_ANSWERS=20
TIERL_SIMILARITY_MIN_OVERLAP=3

# Image storage (internal/media): fs or s3
TIERL_STORAGE_TYPE=fs
TIERL_STORAGE_FS_PATH=./data/media
TIERL_STORAGE_PUBLIC_URL=/media
# For TIERL_STORAGE_TYPE=s3 (MinIO from docker-compose):
# TIERL_S3_ENDPOINT=localhost:9000
# TIERL_S3_BUCKET=tierl-media
# TIERL_S3_ACCESS_KEY=tierl
# TIERL_S3_SECRET_KEY=tierl-secret
# TIERL_S3_REGION=us-east-1
# TIERL_S3_USE_SSL=false
